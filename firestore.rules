rules_version = '2';

// KTN Digital Online School — Firestore security rules
// Paste these into Firebase console → Firestore Database → Rules → Publish.
//
// Summary of who can do what:
//  - Public site (news, gallery, timetable): anyone can READ. Only admin writes.
//  - Admission requests: anyone can CREATE (the Apply form). Only admin reads.
//  - Students / staff / users: only admin manages; teachers read their own class.
//  - Marks & attendance: teacher writes their OWN subject+grade; a student reads
//    only their OWN records; admin can do everything.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin()   { return hasRole() && userDoc().role == 'admin'; }
    function isTeacher() { return hasRole() && userDoc().role == 'teacher'; }
    function isStudent() { return hasRole() && userDoc().role == 'student'; }
    function myGrades()  { return userDoc().grades; }
    function mySubject() { return userDoc().subject; }
    function myStudentId() { return userDoc().studentId; }

    // ---- Public content ----
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /timetable/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /classlinks/{id} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }
    match /directory/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /counters/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Assignments / worksheets ----
    match /assignments/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher() || isAdmin();
    }
    // ---- Assignment submissions (student done / teacher reviewed) ----
    match /submissions/{id} {
      allow read: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.studentId == myStudentId());
      allow create, update: if isAdmin() || isTeacher()
        || (isStudent() && request.resource.data.studentId == myStudentId());
      allow delete: if isAdmin();
    }

    // ---- Admission requests (public Apply form) ----
    match /applications/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Contact messages (public Contact form) ----
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Accounts & roles ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admins create student/teacher login docs on Accept/enrol. Anyone else may
      // only create their OWN account, and only as "pending" (self sign-up).
      allow create: if isAdmin()
                     || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'pending');
      // Only an admin can grant a real role or change/remove accounts.
      allow update, delete: if isAdmin();
    }
    match /students/{id} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.grade in myGrades())
        || (isStudent() && id == myStudentId());
      // Admins have full write. A student may edit only their OWN record, and
      // never change roll number, grade, status, freeze or account link. When
      // the record is frozen, their name and date of birth are locked too.
      allow update: if isAdmin() || (
        isStudent() && id == myStudentId()
        && request.resource.data.rollNumber == resource.data.rollNumber
        && request.resource.data.code == resource.data.code
        && request.resource.data.grade == resource.data.grade
        && request.resource.data.status == resource.data.status
        && request.resource.data.frozen == resource.data.frozen
        && request.resource.data.uid == resource.data.uid
        && (resource.data.frozen != true
            || (request.resource.data.name == resource.data.name
                && request.resource.data.dob == resource.data.dob))
      );
      allow create, delete: if isAdmin();
    }
    match /staff/{id} {
      allow read, write: if isAdmin();
    }

    // ---- Marks (one doc per student: {studentId, grade, subject, term, score}) ----
    match /marks/{id} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.subject == mySubject() && resource.data.grade in myGrades())
        || (isStudent() && resource.data.studentId == myStudentId());
      allow create, update: if isAdmin()
        || (isTeacher()
            && request.resource.data.subject == mySubject()
            && request.resource.data.grade in myGrades());
      allow delete: if isAdmin();
    }

    // ---- Attendance (one doc per student: {studentId, grade, subject, date, status}) ----
    match /attendance/{id} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.subject == mySubject() && resource.data.grade in myGrades())
        || (isStudent() && resource.data.studentId == myStudentId());
      allow create, update: if isAdmin()
        || (isTeacher()
            && request.resource.data.subject == mySubject()
            && request.resource.data.grade in myGrades());
      allow delete: if isAdmin();
    }
  }
}
