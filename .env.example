# ─────────────────────────────────────────────────────────────
# Firebase configuration
# Copy this file to ".env" and paste your own values from the
# Firebase console (Project settings → General → Your apps → SDK setup).
#
# Leave these BLANK to run the app with on-device storage only
# (great for trying it out). Fill them in to switch on real cloud
# sync so admission requests reach you on any device.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Staff area PIN (used to open the staff/admissions screen).
# Change this to something only your teachers know.
VITE_STAFF_PIN=1234

# ─────────────────────────────────────────────────────────────
# Custom welcome email (OPTIONAL) — via EmailJS (free).
# Leave blank to skip the branded welcome email; the secure
# "set your password" link from Firebase is sent either way.
# Get these from emailjs.com after creating a service + template.
# ─────────────────────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Your live site address (used in the welcome email's sign-in link).
VITE_APP_URL=

# ─────────────────────────────────────────────────────────────
# Google Drive upload (OPTIONAL) — auto-saves worksheets to the
# school Drive via the Apps Script backend (see DRIVE-SETUP.md).
# Leave blank to use paste-a-link instead.
# ─────────────────────────────────────────────────────────────
VITE_DRIVE_ENDPOINT=
VITE_DRIVE_TOKEN=
